default_platform(:android)

# Orange Cloud Android — Google Play 上传（fastlane supply）。
# 元数据在 fastlane/metadata/android/<locale>/，版本说明在 changelogs/<versionCode>.txt。
# 图标 / 特征图 / 截图在 metadata/android/<locale>/images/（en-US、ja-JP、zh-CN、zh-HK、zh-TW 五语有图，
# 其余语言留空由 Play 回落到默认语言）。
platform :android do

  # 从 build.gradle.kts 读 versionCode——不传二进制时 supply 无法自行推断
  # 版本说明该挂哪个版本，必须显式给。
  def play_version_code
    File.read("../app/build.gradle.kts")[/versionCode\s*=\s*(\d+)/, 1]
  end

  desc "只推商店文案 + 图标/特征图/截图。不碰版本说明、不碰轨道、不传二进制（validate:true 可干跑）"
  lane :listings do |options|
    upload_to_play_store(
      validate_only: options[:validate] == true,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end

  desc "把 changelogs/<versionCode>.txt 挂到指定轨道的 release。默认 production + draft（不会自动上线）"
  lane :release_notes do |options|
    upload_to_play_store(
      validate_only: options[:validate] == true,
      track: options[:track] || "production",
      version_code: (options[:version_code] || play_version_code).to_i,
      release_status: options[:release_status] || "draft",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "干跑：商店文案 + 版本说明全量送 Play 校验但不落库（validate_only）"
  lane :metadata_check do |options|
    upload_to_play_store(
      validate_only: true,
      version_code: (options[:version_code] || play_version_code).to_i,
      track: options[:track] || "production",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end

  desc "上传 AAB + 元数据到指定轨道。track: internal(默认)/alpha(封闭测试)/beta/production；images:true 才连图一起传"
  lane :deploy do |options|
    track = options[:track] || "internal"
    # 图默认不传：5 语 × 18 张走代理要 ~8 分钟，且发版时图基本没变；
    # 更要紧的是这段是整条链路最容易撞 Google 5xx 的地方，一撞整个 edit 连同
    # 已传的 AAB 一起回滚，白等一轮。改图时单独跑 `listings`（它就是干这个的），
    # 或本 lane 加 images:true。
    upload_images = options[:images] == true
    upload_to_play_store(
      track: track,
      aab: "app/build/outputs/bundle/playRelease/app-play-release.aab",
      skip_upload_images: !upload_images,
      skip_upload_screenshots: !upload_images,
    )
    # 上架生产轨后回调官网，翻出该版本的更新历史（Play 无发布 webhook，故主动通知）。
    notify_website_release if track == "production"
  end

  # 把当前 versionName 通过共享密钥头发给官网 /api/play/release。
  # 需环境变量 PLAY_RELEASE_SECRET（与 Worker secret 同值）。
  private_lane :notify_website_release do
    version = ENV["PLAY_RELEASE_VERSION"] ||
      File.read("../app/build.gradle.kts")[/versionName\s*=\s*"([^"]+)"/, 1]
    secret = ENV["PLAY_RELEASE_SECRET"]
    if version.nil? || secret.nil? || secret.empty?
      UI.important("跳过官网回调：缺 versionName 或 PLAY_RELEASE_SECRET")
      next
    end
    require "net/http"
    require "uri"
    require "json"
    uri = URI("https://oss.omail.us.kg/api/play/release")
    req = Net::HTTP::Post.new(uri, "Content-Type" => "application/json", "X-Play-Secret" => secret)
    req.body = { version: version }.to_json
    res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
    UI.message("官网 Android 上架信号 v#{version} → HTTP #{res.code} #{res.body}")
  end
end
